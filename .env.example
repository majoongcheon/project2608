# .env.example — 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
# .env 는 절대 공유·커밋하지 않는다.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 서비스 포트·도메인
BACKEND_PORT=9523
FRONTEND_PORT=9503
PUBLIC_DOMAIN=p3.sumzip.com
PUBLIC_ORIGIN=https://p3.sumzip.com
SUBMITTER_SALT=
